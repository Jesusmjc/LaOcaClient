<Window x:Class="LaOcaClient.EstadisticasJugador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.globalMisEstadisticas}"
        WindowStartupLocation="CenterScreen"
        Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="tbckMisEstadisticas" Text="{x:Static p:Resources.globalMisEstadisticas}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Grid.Row="0" Margin="10"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="tbckCasillasRecorridas" FontSize="16" TextAlignment="Center" Margin="5"/>
            <TextBlock x:Name="tbckPartidasGanadas" FontSize="16" TextAlignment="Center" Margin="5"/>
        </StackPanel>

        <Button Content="{x:Static p:Resources.btnGlobalRegresar}" Width="100" Height="30" Margin="10" Click="BtnCerrar" Grid.Row="2" HorizontalAlignment="Center"/>
    </Grid>
</Window>