<Window x:Class="LaOcaClient.ConfiguracionSala"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.tituloConfiguracionSala}"
        Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF2F2F2">

    <Grid Margin="20">
        <Label x:Name="lbConfiguracionSala" Content="{x:Static p:Resources.lbCrearSala}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Height="60" Width="300" FontSize="26" FontWeight="Bold" Foreground="#FF333333"/>
        <Label x:Name="lbNombreSala" Content="{x:Static p:Resources.lbNombreSala}" HorizontalAlignment="Left" Margin="200,120,0,0" VerticalAlignment="Top" Height="30" FontSize="14"/>
        <TextBox x:Name="tbxNombreSala" Text="{x:Static p:Resources.lbSalaDe}" MaxLength="50" HorizontalAlignment="Left" Margin="350,120,0,0" VerticalAlignment="Top" Width="300" Height="30" FontSize="14" Background="#FFFFFF" BorderBrush="#FFD1D1D1" BorderThickness="1"/>
        <Label x:Name="lbVisibilidad" Content="{x:Static p:Resources.globalVisibilidad}" HorizontalAlignment="Left" Margin="200,180,0,0" VerticalAlignment="Top" Height="30" FontSize="14"/>
        <ComboBox x:Name="cbVisibilidad" HorizontalAlignment="Left" Margin="350,180,0,0" VerticalAlignment="Top" Width="300" Height="30" Background="#FFFFFF" BorderBrush="#FFD1D1D1" BorderThickness="1"/>
        <Button x:Name="btnCrearSala" Content="{x:Static p:Resources.lbCrearSala}" HorizontalAlignment="Right" Margin="0,350,50,0" VerticalAlignment="Top" Width="200" Height="50" FontSize="16" Background="#FF4CAF50" Foreground="White" BorderBrush="#FF388E3C" BorderThickness="2" Click="IrASala"/>
        <Label x:Name="lbCamposVacios" Content="{x:Static p:Resources.camposVaciosLogin}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,260,0,0" Foreground="Red" FontSize="14" Visibility="Hidden"/>
        <Image x:Name="imgVolver" Margin="20,20,0,0" Source="/Recursos/icono_volver.png" Stretch="Uniform" Height="50" Width="50" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Volver" MouseLeftButtonDown="RegresarAVentanaAnterior"/>
    </Grid>
</Window>