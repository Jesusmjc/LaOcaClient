<Window x:Class="LaOcaClient.CrearCuenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.globalCrearCuenta}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label x:Name="lbCrearCuenta" Content="{x:Static p:Resources.globalCrearCuenta}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontSize="48" Margin="0,20,0,20"/>

            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Label x:Name="lbNombreUsuario" Content="{x:Static p:Resources.globalNombreUsuario}" Margin="0,10,0,0"/>
                <TextBox x:Name="tbxNombreUsuario" TextWrapping="Wrap" Height="26" FontSize="14" Margin="0,5,0,10" MaxLength="12"/>

                <Label x:Name="lbContraseña" Content="{x:Static p:Resources.globalContraseña}" Margin="0,10,0,0"/>
                <PasswordBox x:Name="pbContraseña" Height="26" FontSize="14" Margin="0,5,0,10" MaxLength="16"/>

                <Label x:Name="lbConfirmarContraseña" Content="{x:Static p:Resources.globalConfirmarContraseña}" Margin="0,10,0,0"/>
                <PasswordBox x:Name="pbConfirmarContraseña" Height="26" FontSize="14" Margin="0,5,0,10" MaxLength="16"/>

                <Label x:Name="lbCorreo" Content="{x:Static p:Resources.globalCorreo}" Margin="0,10,0,0"/>
                <TextBox x:Name="tbxCorreo" TextWrapping="Wrap" Height="26" FontSize="14" Margin="0,5,0,20" MaxLength="50"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="btnSiguienteCrearCuenta" Content="{x:Static p:Resources.globalBtnSiguiente}" Width="100" Margin="5,0" Click="BtnSiguienteCrear"/>
                    <Button x:Name="btnSiguienteModificarCuenta" Content="{x:Static p:Resources.globalBtnSiguiente}" Width="100" Margin="5,0" Click="BtnSiguienteModificar"/>
                    <Button x:Name="btnCancelar" Content="{x:Static p:Resources.globalCancelar}" Width="80" Margin="5,0" Click="BtnCancelar"/>
                </StackPanel>
            </StackPanel>

            <Label x:Name="lbSeleccionarImagenPerfil" Content="{x:Static p:Resources.lbSeleccionarImagenPerfil}" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" FontSize="14" Margin="20,0,0,30"/>

            <WrapPanel x:Name="wpImagenesPerfil" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Margin="0,40,0,0">
                <Image x:Name="imgOcaDeportista" Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaDeportista.jpg" Width="100" Height="100" Margin="10" MouseLeftButtonUp="ImagenPerfil_MouseLeftButtonUp"/>
                <Image x:Name="imgOcaDesastrosa" Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaDesastrosa.jpg" Width="100" Height="100" Margin="10" MouseLeftButtonUp="ImagenPerfil_MouseLeftButtonUp"/>
                <Image x:Name="imgOcaIngeniera" Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaIngeniera.jpg" Width="100" Height="100" Margin="10" MouseLeftButtonUp="ImagenPerfil_MouseLeftButtonUp"/>
                <Image x:Name="imgOcaProgramadora" Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaProgramadora.jpg" Width="100" Height="100" Margin="10" MouseLeftButtonUp="ImagenPerfil_MouseLeftButtonUp"/>
                <Image x:Name="imgOcaRockstar" Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaRockstar.jpg" Width="100" Height="100" Margin="10" MouseLeftButtonUp="ImagenPerfil_MouseLeftButtonUp"/>
                <Image x:Name="imgOcaUniversitaria" Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaUniversitaria.jpg" Width="100" Height="100" Margin="10" MouseLeftButtonUp="ImagenPerfil_MouseLeftButtonUp"/>
            </WrapPanel>

            <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="lbIngresarCodigo" Content="{x:Static p:Resources.lbIngresarCodigo}" FontSize="14" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="0"/>
                <TextBox x:Name="tbxCodigoVerificacion" Height="30" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="1" MaxLength="6"/>
                <Button x:Name="btnVerificarCodigo" Content="{x:Static p:Resources.btnVerificarCodigo}" Width="150" Height="30" Click="BtnVerificarCodigo" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="2"/>
                <Button x:Name="btnReenviarCodigo" Content="{x:Static p:Resources.btnReenviarCodigo}" Click="BtnReenviarCodigo" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="3"/>
                <Label x:Name="lbReenviarCodigo" Content="{x:Static p:Resources.btnReenviarCodigo}" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="4"/>
                <Button x:Name="btnVolverAtras" Content="{x:Static p:Resources.btnGlobalRegresar}" Width="150" Click="BtnVolverAtras" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="5"/>
                <Button x:Name="btnCambiarContraseña" Content="{x:Static p:Resources.btnCambiarContraseña}" Width="150" Height="26" Click="BtnCambiarContraseña" Visibility="Collapsed" Margin="0,10,0,0" Grid.Row="6"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>