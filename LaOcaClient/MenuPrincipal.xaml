<Window x:Class="LaOcaClient.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="MenuPrincipal" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.296,0.751">
        <Button x:Name="btnModificarCuenta" Width="128" Content="{x:Static p:Resources.lbModificarCuenta}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnModificarCuenta_Click" Margin="30,19,0,0" FontSize="16"/>
        <Label Content="{x:Static p:Resources.lbTituloOca}" HorizontalAlignment="Center" Margin="0,19,0,0" VerticalAlignment="Top" FontSize="46"/>
        <Button Content="{x:Static p:Resources.btnBuscarPartida}" HorizontalAlignment="Center" Margin="0,117,0,0" VerticalAlignment="Top" Width="184" Height="63" FontSize="22"/>
        <Button Content="{x:Static p:Resources.btnUnirsePartida}" HorizontalAlignment="Center" Margin="0,205,0,0" VerticalAlignment="Top" Width="184" Height="63" FontSize="24" Click="Button_Click_1"/>
        <Button Content="{x:Static p:Resources.btnCrearPartida}" HorizontalAlignment="Center" Margin="0,289,0,0" VerticalAlignment="Top" Width="184" Height="63" FontSize="26" Click="Button_Click"/>
        <Button Content="{x:Static p:Resources.globalSalir}" HorizontalAlignment="Center" Margin="0,378,0,0" VerticalAlignment="Top" Width="92" FontSize="16" Click="BtnSalir_Click"/>
        <Button Content="{x:Static p:Resources.globalConfiguración}" HorizontalAlignment="Left" Margin="659,19,0,0" VerticalAlignment="Top" Width="113" FontSize="16"/>
        <Button Content="{x:Static p:Resources.globalSocial}" HorizontalAlignment="Left" Margin="550,19,0,0" VerticalAlignment="Top" Width="88" FontSize="16"/>
    </Grid>
</Window>