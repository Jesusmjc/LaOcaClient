<Window x:Class="LaOcaClient.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="Menú Principal" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Título del juego -->
        <Label Content="{x:Static p:Resources.lbTituloOca}" 
               Grid.Row="0" Grid.Column="1" 
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="36" FontWeight="Bold" Margin="0,20,0,20"/>

        <!-- Botones principales -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Button Content="{x:Static p:Resources.btnBuscarPartida}" 
                    Width="200" Height="40" FontSize="16" Margin="0,10"/>
            <Button Content="{x:Static p:Resources.btnCrearPartida}" 
                    Width="200" Height="40" FontSize="16" Margin="0,10"
                    Click="IrAConfiguracionSala"/>
            <Button Content="{x:Static p:Resources.btnUnirsePartida}" 
                    Width="200" Height="40" FontSize="16" Margin="0,10"
                    Click="UnirseASala"/>
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Código de Sala:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                <TextBox x:Name="tbxCodigoSala" Width="75" Height="30" FontSize="16"/>
            </StackPanel>
        </StackPanel>

        <!-- Botones de navegación y configuración -->
        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Ver Ranking Global" Width="150" Height="30" Margin="10"
                    Click="BtnVerRankingGlobal_Click" HorizontalAlignment="Left"/>
            <Button Content="Ver Mis Estadísticas" 
                    Width="150" Height="40" FontSize="14" Margin="10"
                    Click="BtnVerEstadisticas_Click"/>
            <Button x:Name="btnSocial" Content="{x:Static p:Resources.globalSocial}" 
                    Width="150" Height="40" FontSize="14" Margin="10"
                    Click="MostrarListaAmigos"/>
        </StackPanel>

        <!-- Botón Modificar cuenta y salir -->
        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button x:Name="btnModificarCuenta" 
                    Content="Modificar Cuenta" 
                    Width="150" Height="40" FontSize="14" Margin="10"
                    Click="btnModificarCuenta_Click"/>
            <Button Content="{x:Static p:Resources.globalConfiguración}" 
                    Width="150" Height="40" FontSize="14" Margin="10"/>
            <Button x:Name="btnSalir" 
                    Content="{x:Static p:Resources.globalSalir}" 
                    Width="150" Height="40" FontSize="14" Margin="10"
                    Click="CerrarSesion"/>
        </StackPanel>
    </Grid>
</Window>
