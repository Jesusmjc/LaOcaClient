<Window x:Class="LaOcaClient.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.tituloMenuPrincipal}" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Label Content="{x:Static p:Resources.lbTituloOca}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold" Margin="0,60,0,20"/>

        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Button Name="btnCrearSala" Content="{x:Static p:Resources.btnCrearPartida}" Width="200" Height="40" FontSize="16" Margin="0,10" Click="IrAConfiguracionSala"/>
            <Button Content="{x:Static p:Resources.btnUnirsePartida}" Width="200" Height="40" FontSize="16" Margin="0,10" Click="UnirseASala"/>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="{x:Static p:Resources.lbCodigoSala}" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                <TextBox x:Name="tbxCodigoSala" Width="75" Height="30" FontSize="16" MaxLength="4"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="btnRankingGlobal" Content="{x:Static p:Resources.btnVerRankingGlobal}" Width="150" Height="40" Margin="10" Click="BtnVerRankingGlobal"/>
            <Button x:Name="btnEstadisticas" Content="{x:Static p:Resources.btnVerEstdísticas}" Width="150" Height="40" FontSize="14" Margin="10" Click="BtnVerEstadisticas"/>
            <Button x:Name="btnSocial" Content="{x:Static p:Resources.globalSocial}" Width="150" Height="40" FontSize="14" Margin="10" Click="MostrarListaAmigos"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button x:Name="btnModificarCuenta" Content="{x:Static p:Resources.lbModificarCuenta}" Width="150" Height="40" FontSize="14" Margin="10" Click="BtnModificarCuenta"/>
            <Button x:Name="btnSalir" Content="{x:Static p:Resources.globalSalir}" Width="150" Height="40" FontSize="14" Margin="10" Click="CerrarSesion"/>
        </StackPanel>
    </Grid>
</Window>