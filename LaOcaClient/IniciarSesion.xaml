<Window x:Class="LaOcaClient.IniciarSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="{x:Static p:Resources.lbInicioSesion}"
        Background="Transparent">

    <Grid>
        <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/FondoLogin.jpg" Stretch="Fill" Opacity="0.9"/>

        <Grid>
            <ComboBox x:Name="cbIdioma" Width="200" Height="40" Margin="30" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" SelectionChanged="CbIdioma_SelectionChanged">
                <ComboBoxItem Content="English" Tag="en-US"/>
                <ComboBoxItem Content="Español" Tag="es-MX"/>
            </ComboBox>

            <TextBlock Text="{x:Static p:Resources.lbTituloOca}" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="80" FontWeight="Bold" Foreground="White" Margin="0,30,0,0" TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Background="#BF1C2833" CornerRadius="20" Padding="30" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                
                <StackPanel>
                    <Label Content="{x:Static p:Resources.globalCorreo}" Foreground="White" FontSize="18" Margin="0,5"/>
                    <TextBox x:Name="tbxCorreoElectronico" Height="45" FontSize="16" BorderBrush="#FF9CCC65" BorderThickness="2" MaxLength="50"/>
                    <Label Content="{x:Static p:Resources.globalContraseña}" Foreground="White" FontSize="18" Margin="0,15,0,5"/>
                    <PasswordBox x:Name="pbContrasena" Height="45" FontSize="16" BorderBrush="#FF9CCC65" BorderThickness="2" MaxLength="16"/>
                    <Button Content="{x:Static p:Resources.btnIniciarSesion}" Height="50" Width="250" Background="#FF81C784" Foreground="White" BorderBrush="#FF66BB6A" FontSize="18" FontWeight="Bold" Margin="0,30,0,10" HorizontalAlignment="Center" Click="ValidarInicioSesion"/>
                    <Button Content="{x:Static p:Resources.btnOlvideMiContraseña}" Background="Transparent" Foreground="#FF90CAF9" BorderBrush="Transparent" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14" Click="BtnOlvideMiContraseña"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                        <Label Content="{x:Static p:Resources.lbNoTengoCuenta}" Foreground="White" FontSize="14"/>
                        <Button Content="{x:Static p:Resources.btnCrearCuenta}" Background="Transparent" Foreground="#FF90CAF9" BorderBrush="Transparent" FontWeight="Bold" FontSize="14" Click="BtnCrearCuentaNueva"/>
                    </StackPanel>

                    <Button Content="{x:Static p:Resources.globalJugarComoInvitado}" Background="Transparent" Foreground="#FF90CAF9" BorderBrush="Transparent" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0" Click="EntrarComoInvitado"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
