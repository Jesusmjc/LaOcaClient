<UserControl x:Class="LaOcaClient.UserControls.Amigo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaOcaClient.UserControls"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="10"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid HorizontalAlignment="Stretch">
        <Rectangle Height="100" Margin="0,0,0,0" Stroke="#FF00384A" Fill="LightSkyBlue" VerticalAlignment="Center"/>
        <Image x:Name="imgFotoPerfil" HorizontalAlignment="Left" Source="/Recursos/icono_usuario.png" Height="60" VerticalAlignment="Center" Width="60" Margin="20,0,0,0"/>
        <Label x:Name="lbNombreAmigo" Content="NombreJugador" Margin="100,0,450,0" VerticalAlignment="Center" FontSize="16"/>
        <Label x:Name="lbEstado" Content="Mensaje" Margin="360,0,120,0" VerticalAlignment="Center" FontSize="16"/>
        <Image x:Name="imgMasOpciones" HorizontalAlignment="Right" Source="/Recursos/icono_masopciones.png" Height="40" VerticalAlignment="Center" Width="40" Margin="0,0,20,0" MouseLeftButtonUp="MostrarMenúPopup">
            <Image.ContextMenu>
                <ContextMenu x:Name="imgMasOpciones_MenuContextual">
                </ContextMenu>
            </Image.ContextMenu>
        </Image>

    </Grid>
</UserControl>
