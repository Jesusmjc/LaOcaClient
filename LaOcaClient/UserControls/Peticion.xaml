<UserControl x:Class="LaOcaClient.UserControls.Peticion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaOcaClient.UserControls"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="10"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid HorizontalAlignment="Stretch">
        <Rectangle Height="100" Margin="0,0,0,0" Stroke="#FF00384A" Fill="LightSkyBlue" VerticalAlignment="Center"/>
        <Image x:Name="imgFotoPerfil" HorizontalAlignment="Left" Source="/Recursos/icono_usuario.png" Height="60" VerticalAlignment="Center" Width="60" Margin="20,0,0,0"/>
        <Label x:Name="lbMensaje" Content="Mensaje" Margin="100,0,220,0" VerticalAlignment="Center" FontSize="16"/>
        <Button x:Name="btnRechazar" Content="Rechazar" Margin="0,0,20,0" VerticalAlignment="Center" Height="40" HorizontalAlignment="Right" Width="80" Background="#FFFA9999" BorderBrush="#FF030000" Click="RechazarPeticion"/>
        <Button x:Name="btnAceptar" Content="Aceptar" Margin="0,0,120,0" VerticalAlignment="Center" Height="40" HorizontalAlignment="Right" Width="80" Background="#FFC3FD9B" BorderBrush="#FF020000" Click="AceptarPeticion"/>
    </Grid>
</UserControl>
