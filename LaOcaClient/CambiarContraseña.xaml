<Window x:Class="LaOcaClient.CambiarContraseña"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.btnCambiarContraseña}" Height="500" Width="600"
        Background="LightGray" WindowStartupLocation="CenterScreen" WindowStyle="ThreeDBorderWindow">

    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <Grid>
                <Button x:Name="btnRegresar" Content="{x:Static p:Resources.btnGlobalRegresar}" 
                        HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Height="30"
                        Margin="10,10,0,0" Click="BtnVolver" Background="LightBlue" BorderBrush="DarkGray"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock x:Name="tbckContraseñaActual" Text="{x:Static p:Resources.lbContraseñaActual}" 
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>
                        <PasswordBox x:Name="pbContraseñaActual" Height="30" MaxLength="16"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock x:Name="tbckContraseñaNueva" Text="{x:Static p:Resources.lbIngresarNuevaContraseña}" 
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>
                        <PasswordBox x:Name="pbNuevaContraseña" Height="30" MaxLength="16"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock x:Name="tbckConfirmarContraseña" Text="{x:Static p:Resources.lbConfirmarNuevaContraseña}" 
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>
                        <PasswordBox x:Name="pbConfirmarNuevaContraseña" Height="30" MaxLength="16"/>
                    </StackPanel>

                    <Button x:Name="btnCambiarContraseña" Content="{x:Static p:Resources.btnCambiarContraseña}" 
                            Height="40" Width="250" Background="LightBlue" BorderBrush="DarkGray"
                            HorizontalAlignment="Center" Click="BtnActualizarContraseña" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
