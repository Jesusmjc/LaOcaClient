<Window x:Class="LaOcaClient.CambiarContraseña"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.btnCambiarContraseña}" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="40">
            <TextBlock Text="{x:Static p:Resources.lbContraseñaActual}" Margin="0,0,0,10"/>
            <PasswordBox x:Name="tbContraseñaActual" Margin="0,0,0,20"/>

            <TextBlock Text="{x:Static p:Resources.lbIngresarNuevaContraseña}" Margin="0,0,0,10"/>
            <PasswordBox x:Name="tbNuevaContraseña" Margin="0,0,0,20"/>

            <TextBlock Text="{x:Static p:Resources.lbConfirmarNuevaContraseña}" Margin="0,0,0,10"/>
            <PasswordBox x:Name="tbConfirmarNuevaContraseña" Margin="0,0,0,20"/>

            <Button Content="{x:Static p:Resources.btnCambiarContraseña}" Click="btnActualizarContraseña_Click" Margin="0,0,0,20"/>
        </StackPanel>
        <Button Content="{x:Static p:Resources.btnGlobalRegresar}" Margin="606,321,116,10" Click="btnVolver_Click" Height="20" Width="60"/>

    </Grid>
</Window>
