<Window x:Class="LaOcaClient.Sala"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        mc:Ignorable="d"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        Title="{x:Static p:Resources.globalSala}" Height="600" Width="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FFF2F2F2">
    
    <Grid>
        <ListBox x:Name="lbxChat" HorizontalAlignment="Left" Height="100" Margin="30,450,0,0" VerticalAlignment="Top" Width="500" Background="#FFF9F9F9" BorderBrush="#FFD1D1D1" BorderThickness="1"/>
        <TextBox x:Name="tbxMensaje" MaxLength="100" HorizontalAlignment="Left" Margin="30,560,0,0" TextWrapping="Wrap" Text="{x:Static p:Resources.lbEscribeUnMsg}" VerticalAlignment="Top" Width="500" Height="40" FontSize="14" Background="#FFFFFF" BorderBrush="#FFD1D1D1" BorderThickness="1" KeyDown="EnviarMensaje" GotFocus="LimpiarTextoEjemplo"/>
        <Image x:Name="imgVolver" Margin="20,20,0,0" Source="/Recursos/icono_volver.png" Stretch="Uniform" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" MouseLeftButtonDown="RegresarAMenuPrincipal" ToolTip="Volver"/>

        <Border HorizontalAlignment="Left" Margin="100,150,0,0" VerticalAlignment="Top" Width="100" Height="100" BorderBrush="#FFD1D1D1" BorderThickness="1" Background="#FFECECEC">
            <Grid x:Name="gridJugadorSala1"/>
        </Border>

        <Border HorizontalAlignment="Left" Margin="270,150,0,0" VerticalAlignment="Top" Width="100" Height="100" BorderBrush="#FFD1D1D1" BorderThickness="1" Background="#FFECECEC">
            <Grid x:Name="gridJugadorSala2"/>
        </Border>

        <Border HorizontalAlignment="Left" Margin="440,150,0,0" VerticalAlignment="Top" Width="100" Height="100" BorderBrush="#FFD1D1D1" BorderThickness="1" Background="#FFECECEC">
            <Grid x:Name="gridJugadorSala3"/>
        </Border>

        <Border HorizontalAlignment="Left" Margin="610,150,0,0" VerticalAlignment="Top" Width="100" Height="100" BorderBrush="#FFD1D1D1" BorderThickness="1" Background="#FFECECEC">
            <Grid x:Name="gridJugadorSala4"/>
        </Border>

        <Rectangle HorizontalAlignment="Left" Height="60" Margin="400,20,0,0" Stroke="#FFD1D1D1" VerticalAlignment="Top" Width="250" Fill="#FFF9F9F9" RadiusX="8" RadiusY="8"/>
        <Label Content="{x:Static p:Resources.lbCodigoSala}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="40" Margin="420,30,0,0" VerticalAlignment="Top" Width="130" FontSize="16" FontWeight="Bold"/>
        <Label x:Name="lbCodigoSala" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="0000" HorizontalAlignment="Left" Height="40" Margin="560,30,0,0" VerticalAlignment="Top" Width="80" FontSize="16" FontWeight="Bold"/>
        <Label x:Name="lbNombreSala" Content="{x:Static p:Resources.lbSalaDe}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="65,20,0,0" VerticalAlignment="Top" Height="50" Width="310" FontSize="26" FontWeight="Bold" Foreground="#FF333333"/>
        <Button x:Name="btnIniciarPartida" Content="{x:Static p:Resources.btnIniciarPartida}" HorizontalAlignment="Right" Margin="0,550,30,0" VerticalAlignment="Top" Height="50" Width="200" FontSize="16" Background="#FF4CAF50" Foreground="White" BorderBrush="#FF388E3C" BorderThickness="2" Click="IniciarPartida" IsEnabled="False" Visibility="Hidden"/>
        <Button x:Name="btnAmigos" Content="{x:Static p:Resources.lbAmigos}" HorizontalAlignment="Right" Margin="0,20,30,0" VerticalAlignment="Top" Width="80" Height="50" FontSize="14" Background="#FF2196F3" Foreground="White" BorderBrush="#FF1976D2" BorderThickness="2" Click="MostrarAmigos"/>
    </Grid>
</Window>