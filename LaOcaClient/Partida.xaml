<Window x:Class="LaOcaClient.Partida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Partida"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Tablero principal en el lado izquierdo -->
        <Viewbox Stretch="Uniform" Grid.Column="0">
            <Grid>
                <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/TableroOcaActualizado.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Canvas Name="TableroCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Name="FichaOcaAmarilla" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaAmarilla.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                    <Image Name="FichaOcaAzul" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaAzul.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                    <Image Name="FichaOcaRosa" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaRosa.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                    <Image Name="FichaOcaVerde" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaVerde.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- Panel de información y jugadores en el lado derecho -->
        <Border Grid.Column="1" Background="#80FFFFFF" Padding="20" Margin="10">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Cuadrícula para los jugadores (2x2) -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="gridJugador1" Grid.Row="0" Grid.Column="0" Height="140" Width="140" Margin="10">
                        <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaDeportista.jpg" Stretch="UniformToFill"/>
                    </Grid>
                    <Grid x:Name="gridJugador2" Grid.Row="0" Grid.Column="1" Height="140" Width="140" Margin="10">
                        <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaIngeniera.jpg" Stretch="UniformToFill"/>
                    </Grid>
                    <Grid x:Name="gridJugador3" Grid.Row="1" Grid.Column="0" Height="140" Width="140" Margin="10">
                        <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaProgramadora.jpg" Stretch="UniformToFill"/>
                    </Grid>
                    <Grid x:Name="gridJugador4" Grid.Row="1" Grid.Column="1" Height="140" Width="140" Margin="10">
                        <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/OcaDesastrosa.jpg" Stretch="UniformToFill"/>
                    </Grid>
                </Grid>
                <Button x:Name="BtnDados" Content="Lanzar Dados" Margin="10" Click="LanzarDado" Height="42" Width="108" FontSize="16" IsEnabled="False"/>
                <Label Content="Turno de:" Margin="10" VerticalAlignment="Center"/>
                <Label x:Name="lbNombreJugadorEnTurno" Content="fulano" Margin="10" VerticalAlignment="Center"/>
                <Button Content="Regresar" HorizontalAlignment="Left" Margin="10" VerticalAlignment="Top"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
