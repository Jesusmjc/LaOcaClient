<Window x:Class="LaOcaClient.Partida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaOcaClient"
        mc:Ignorable="d"
        Title="Partida" Height="450" Width="800">
    <Grid>
        <Grid x:Name="gridJugador1" HorizontalAlignment="Left" Height="140" Margin="20,10,0,0" VerticalAlignment="Top" Width="100"/>
        <Grid x:Name="gridJugador2" HorizontalAlignment="Left" Height="140" Margin="140,10,0,0" VerticalAlignment="Top" Width="100"/>
        <Grid x:Name="gridJugador3" HorizontalAlignment="Left" Height="140" Margin="260,10,0,0" VerticalAlignment="Top" Width="100"/>
        <Grid x:Name="gridJugador4" HorizontalAlignment="Left" Height="140" Margin="380,10,0,0" VerticalAlignment="Top" Width="100"/>
        <Button x:Name="btnDados" Content="Lanzar Dados" HorizontalAlignment="Center" Margin="0,297,0,0" VerticalAlignment="Top" Click="LanzarDados" Height="42" Width="108" FontSize="16" IsEnabled="False"/>
        <Label Content="Turno de:" HorizontalAlignment="Left" Margin="614,37,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lbNombreJugadorEnTurno" Content="fulano" HorizontalAlignment="Left" Margin="679,37,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
