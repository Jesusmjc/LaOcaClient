<Window x:Class="LaOcaClient.Partida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:LaOcaClient.Properties"
        Title="{x:Static p:Resources.tituloPartida}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FFEBF5E6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Viewbox Stretch="Uniform" Grid.Column="0" Margin="10">
            <Grid Background="#FFF2F8E1" ClipToBounds="True">
                <Border Background="#FFFFFF" CornerRadius="10" Margin="10" Opacity="0.95">
                    <Image Source="pack://application:,,,/LaOcaClient;component/Recursos/TableroOcaActualizado.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Canvas x:Name="cvTablero" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="imgFichaOcaAmarilla" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaAmarilla.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                    <Image x:Name="imgFichaOcaAzul" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaAzul.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                    <Image x:Name="imgFichaOcaRosa" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaRosa.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                    <Image x:Name="imgFichaOcaVerde" Source="pack://application:,,,/LaOcaClient;component/Recursos/FichaOcaVerde.png" Width="85" Height="85" Canvas.Left="-584" Canvas.Top="315" Visibility="Collapsed"/>
                </Canvas>

                <StackPanel x:Name="FichasJugadoresPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,134,0,0">
                    <TextBlock Text="{x:Static p:Resources.lbJugadoresEnPartida}" FontWeight="Bold" FontSize="18" Foreground="#444444"/>
                </StackPanel>
            </Grid>
        </Viewbox>
        
        <Button x:Name="btnComprobarConexion" Content="Comprobar Conexión" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" Height="40" Margin="10" Click="BtnComprobarConexion_Click" />

        <Border Grid.Column="1" Background="#E6FFFFFF" Padding="20" Margin="10" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.5" Color="Gray"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFF2F8E1" CornerRadius="10" Margin="10" Padding="5" Grid.Row="0" Grid.Column="0">
                        <Grid x:Name="gridJugador1" Height="140" Width="140"/>
                    </Border>

                    <Border Background="#FFF2F8E1" CornerRadius="10" Margin="10" Padding="5" Grid.Row="0" Grid.Column="1">
                        <Grid x:Name="gridJugador2" Height="140" Width="140"/>
                    </Border>

                    <Border Background="#FFF2F8E1" CornerRadius="10" Margin="10" Padding="5" Grid.Row="1" Grid.Column="0">
                        <Grid x:Name="gridJugador3" Height="140" Width="140"/>
                    </Border>

                    <Border Background="#FFF2F8E1" CornerRadius="10" Margin="10" Padding="5" Grid.Row="1" Grid.Column="1">
                        <Grid x:Name="gridJugador4" Height="140" Width="140"/>
                    </Border>
                </Grid>

                <Label Content="{x:Static p:Resources.lbEsTurnoDe}" Margin="10" FontSize="18" Foreground="#333333" HorizontalAlignment="Center"/>
                <Label x:Name="lbNombreJugadorEnTurno" Content="fulano" FontSize="20" FontWeight="Bold" Foreground="#FF388E3C" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                    <Button x:Name="btnDado" Content="{x:Static p:Resources.btnLanzarDado}" Margin="10" Click="LanzarDado" Height="50" Width="140" FontSize="16" Background="#FF1976D2" Foreground="White" BorderBrush="#FF388E3C" FontWeight="Bold" Cursor="Hand"/>
                    <Image x:Name="imgDado" Source="pack://application:,,,/LaOcaClient;component/Recursos/Dado.png" Width="50" Height="50" Margin="10" Visibility="Visible"/>
                </StackPanel>

                <Button Name="btnAbandonar" Content="{x:Static p:Resources.btnAbandonarPartida}" Margin="10" Click="BtnAbandonar" Height="50" Width="170" FontSize="16" Background="#FFDD4B39" Foreground="White" BorderBrush="#FFC62828" FontWeight="Bold" Cursor="Hand"/>
                <Label x:Name="lbNotificacion" Content="" HorizontalAlignment="Center" Margin="10,10,10,0" FontSize="14" FontWeight="Normal" Foreground="Red" Visibility="Visible"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>